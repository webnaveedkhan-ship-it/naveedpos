# ========================================================
# NaveedPOS Production SaaS Environment Variables
# ========================================================

# Server Runtime Configuration
PORT=5055
NODE_ENV=production

# Database (MongoDB Atlas Managed Cloud Cluster)
# Example: mongodb+srv://naveedpos_admin:<password>@cluster0.abcde.mongodb.net/naveedpos?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/naveedpos?retryWrites=true&w=majority

# JWT Authentication Security
JWT_SECRET=super_secret_jwt_encryption_key_min_32_chars_long
JWT_EXPIRE=7d

# Cross-Origin Resource Sharing (CORS) Whitelist
# For multiple domains, separate by commas:
CLIENT_URL=https://naveedpos.vercel.app,https://app.naveedpos.com,http://localhost:5172

# Default Tax Rate (Percentage in Pakistan e.g., 8%)
DEFAULT_TAX_RATE=8

# Persistent Cloud Media Storage (ImageKit.io CDN)
# Free account gives 20GB bandwidth & 20GB media storage with real-time CDN delivery
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
