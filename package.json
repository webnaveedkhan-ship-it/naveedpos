{
  "name": "naveedpos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NaveedPOS - Production-Ready Point of Sale System",
  "scripts": {
    "install:client": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "start": "node server/src/server.js",
    "seed": "npm --prefix server run seed"
  },
  "keywords": ["pos", "point-of-sale", "mern", "express", "react", "tailwind"],
  "author": "NaveedPOS",
  "license": "ISC"
}
